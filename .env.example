# ---------------------------------------------------------------------------
# Pharma QA Reminder System - environment configuration (PLACEHOLDERS ONLY)
# Copy to .env on the server and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Django core
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
# Frontend origin(s) allowed to call the API (GitHub Pages origin has no path)
CORS_ALLOWED_ORIGINS=https://yourgithubuser.github.io
CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
FRONTEND_URL=https://yourgithubuser.github.io/Pharma-Advanced/
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=0
ENABLE_DJANGO_ADMIN=false

# Business timezone used for "today" (admins can override in System Settings)
BUSINESS_TIMEZONE=Asia/Kolkata

# SQLite (keep on local disk; enable WAL only on a local, non-network filesystem)
SQLITE_PATH=/home/yourusername/qa-data/db.sqlite3
SQLITE_WAL=false
PRIVATE_UPLOAD_ROOT=/home/yourusername/qa-data/uploads
BACKUP_ROOT=/home/yourusername/qa-data/backups
MAX_WORKBOOK_BYTES=26214400
MAX_WORKBOOK_ROWS=50000

# Server folders usable as data sources: name=/absolute/path;name2=/absolute/path2
# Only folders the APPLICATION SERVER can read. Paths are never shown in the UI.
SOURCE_ROOTS=qms=/home/yourusername/qa-sources

# External scheduler trigger (POST /api/jobs/tick/ with header X-Job-Token).
# Needed where the host has no scheduler (e.g. PythonAnywhere free accounts). Empty = disabled.
JOB_TRIGGER_TOKEN=

# Auth hardening
AUTH_TOKEN_TTL_HOURS=10
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false
LOG_DIR=/home/yourusername/qa-data/logs

# One-time admin bootstrap (python manage.py bootstrap_admin), then REMOVE ADMIN_PASSWORD
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Microsoft Graph for OneDrive/SharePoint data sources (app-only) ----------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# --- Email sender credentials --------------------------------------------------
# Each sender profile has a "secret env prefix" (e.g. SENDER_MAIN). Variables are
# <PREFIX>_<NAME>. Set only the ones for the provider you use.
# Microsoft 365 (Graph sendMail, Mail.Send application permission):
SENDER_MAIN_GRAPH_TENANT_ID=
SENDER_MAIN_GRAPH_CLIENT_ID=
SENDER_MAIN_GRAPH_CLIENT_SECRET=
# Google Gmail API (OAuth refresh token with gmail.send scope):
SENDER_MAIN_GMAIL_CLIENT_ID=
SENDER_MAIN_GMAIL_CLIENT_SECRET=
SENDER_MAIN_GMAIL_REFRESH_TOKEN=
# SMTP (only where the provider/tenant allows SMTP AUTH; e.g. Gmail app password):
SENDER_MAIN_SMTP_PASSWORD=
